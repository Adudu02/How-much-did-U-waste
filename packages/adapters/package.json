  "type": "module",
  "description": "Coding-agent adapter pack for agent-usage-engine: Claude Code, Codex, Qwen, ZCode, Gemini CLI, OpenCode, Grok, Goose, Amp and Crush ingestion adapters plus built-in quota probers. No server, no UI.",
  "license": "MIT",
  "author": "Adudu02",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adudu02/How-much-did-U-waste.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/Adudu02/How-much-did-U-waste#readme",
  "bugs": {
    "url": "https://github.com/Adudu02/How-much-did-U-waste/issues"
  },
  "keywords": [
    "llm",
    "ai-agents",
    "claude-code",
    "codex",
    "qwen",
